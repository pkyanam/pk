#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
USER_HOME=$(cd ~ && pwd)
BIN_DIR=${PK_BIN_DIR:-"$USER_HOME/.local/bin"}
LIB_DIR=${PK_LIB_DIR:-"$USER_HOME/.local/lib/pk"}
"$ROOT/scripts/build"
mkdir -p "$BIN_DIR" "$LIB_DIR"
STAGED_UI="$LIB_DIR/.ui-stage-$$"
cleanup() {
  [ ! -d "$STAGED_UI" ] || rm -rf "$STAGED_UI"
}
trap cleanup EXIT HUP INT TERM
mkdir -p "$STAGED_UI"
cp "$ROOT/ui/package.json" "$ROOT/ui/bun.lock" "$STAGED_UI/"
cp -R "$ROOT/ui/dist" "$STAGED_UI/"
(cd "$STAGED_UI" && bun install --production --frozen-lockfile)
if [ -x "$BIN_DIR/pk" ] && [ -d "$LIB_DIR/ui" ]; then
  "$ROOT/bin/pk" __install-artifacts --binary "$ROOT/bin/pk" --ui "$STAGED_UI" --source "$ROOT" --legacy-binary "$BIN_DIR/pk" --legacy-ui "$LIB_DIR/ui"
else
  "$ROOT/bin/pk" __install-artifacts --binary "$ROOT/bin/pk" --ui "$STAGED_UI" --source "$ROOT"
fi
cleanup
trap - EXIT HUP INT TERM
echo "Installed pk launcher to $BIN_DIR/pk"
echo "OpenTUI assets are paired with the active immutable release in $LIB_DIR/current"
